---
import { SEO } from "astro-seo";
import { GITHUB_URL, SITE_DESC, SITE_TITLE, WEBSITE_URL } from "@/utils/constants";

const { title, ogImage } = Astro.props;

const CANONICAL_URL = new URL(Astro.url.pathname, WEBSITE_URL)
const DEFAULT_IMAGE = `${GITHUB_URL}.png`;
---

<SEO
    title = `🌱 ${title ?? SITE_TITLE}`
    description = {SITE_DESC}
    canonical = {CANONICAL_URL}
    extend = {{
        link: [
            {
                rel: "icon",
                href: DEFAULT_IMAGE
            },
        ],
        meta: [
            {
                name: "twitter:title",
                content: `🌱 ${title ?? title + ' • ' + SITE_TITLE}`
            },
            {
                name: "twitter:description",
                content: SITE_DESC
            },
            {
                name: "twitter:image",
                content: ogImage
            },
            {
                name: "twitter:url",
                content: Astro.url
            },
            {
                name: "twitter:card",
                content: "summary_large_image"
            },
            {
                property: "og:title",
                content: `🌱 ${title ?? SITE_TITLE}`
            },
            {
                property: "og:description",
                content: SITE_DESC
            },
            {
                property: "og:image",
                content: ogImage
            },
            {
                property: "og:url",
                content: Astro.url
            },
            {
                property: "og:type",
                content: "website"
            }
        ],
    }}
/>

<meta name="generator" content={Astro.generator} />
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
