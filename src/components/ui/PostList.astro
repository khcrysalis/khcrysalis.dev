---
import FormattedDate from './FormattedDate.astro'
import type { PostListProps } from '@/utils/types'
const { posts } = Astro.props as PostListProps
import "@/styles/boxes.scss";

// Group posts by year
const groupedPosts = posts.reduce((acc, post) => {
    const year = new Date(post.data.pubDate).getFullYear()
    if (!acc[year]) acc[year] = []
    acc[year].push(post)
    return acc
}, {} as Record<number, typeof posts>)

const sortedYears = Object.keys(groupedPosts).sort((a, b) => Number(b) - Number(a))

function getExcerpt(content: string, length = 500) {
  return content
    .replace(/[#_*`>~\-!\[\]\(\)]/g, "") // strip markdown chars
    .trim()
    .slice(0, length) + "…"
}

---

<div class="timeline">
    { sortedYears.map((year) => (
        <>
            <div class="year-container">
                <span class="dot year-dot"></span>
                <div class="year-heading">{year}</div>
            </div>
            { groupedPosts[Number(year)].map((post) => (
                <a href={`/${post.id}`} class="box-container special-box post-container">
                    <span class="dot post-dot"></span>
                    <div class="post-content">
                        <div class="date"><FormattedDate date={post.data.pubDate}/></div>
                        <h3 class="title">{post.data.title}</h3>
                        <p class="excerpt">{getExcerpt(post.body ? post.body : "")}</p>
                    </div>
                </a>

            ))}
        </>
    ))}
</div>

<style>
    .timeline {
        display: flex;
        padding-left: 1rem;
        margin-left: 0.5rem;
        flex-direction: column;
        gap: 1.5rem;
        position: relative;
    }

    .timeline::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        width: 2px;
        height: 100%;
        background: linear-gradient(
            to bottom,
            transparent,
            var(--background-secondary) 15%,
            var(--background-secondary) 85%,
            transparent
        );
    }

    .year-container {
        position: relative;
    }

    .post-container {
        position: relative;
    }

    .dot {
        position: absolute;
        border-radius: 50%;
        transform: translateX(1px);
    }

    .year-dot {
        width: 14px;
        height: 14px;
        left: -1.432rem;
        background-color: var(--text-prominent);
        top: 1.9rem;
    }

    .post-dot {
        width: 8px;
        height: 8px;
        left: -1.35rem;
        background-color: var(--background-secondary);
        top: 1.8rem;
    }

    .year-heading {
        font-size: 2.0rem;
        font-weight: 700;
        color: var(--text-prominent);
        margin-top: 1rem;
        letter-spacing: 0.05em;
    }

    .post-content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .date {
        font-size: 0.85rem;
        color: var(--text-quaternary);
        font-weight: 500;
    }

    .title {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0.1rem 0 0;
        line-height: 1.3;
    }

    .excerpt {
        overflow: hidden;
        position: relative;
        line-height: 1.5;
        font-size: 0.95rem;
        color: var(--text-quaternary);
        margin: 0.6rem 0 0;
    }

    .excerpt::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 1.5rem;
        background: linear-gradient(to bottom, transparent, var(--background-tertiary));
        pointer-events: none;
        transition: all 0.2s ease;
    }

    .post-container:hover .excerpt::after {
        background: linear-gradient(to bottom, transparent, var(--background-primary));
    }
</style>
