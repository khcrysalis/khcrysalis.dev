---
import LayoutGeneral from "./LayoutGeneral.astro";
import Head from "@/components/Head.astro";
import Footer from "@/components/layout/Footer.astro";
import PostHeading from "@/components/posts/PostHeading.astro";
import TableOfContents from "@/components/posts/TableOfContents.astro";
import type { PostLayoutProps } from "@/utils/types";
import { formatDate } from "@/utils/utils";

const { title, pubDate, toc } = Astro.props as PostLayoutProps

const postSlug = Astro.url.pathname.split('/').filter(Boolean).pop() || ''
const ogImage = `/open-graph/${postSlug}.png`
---

<LayoutGeneral>
    <Head
        title={title}
        ogImage={ogImage}
        slot="head"
    />
    <div class="post-content">
        <TableOfContents toc={toc}/>
        <main>
            <PostHeading title={title} pubDate={pubDate}/>
            <slot/>
            <hr/>
            <Footer/>
        </main>
    </div>
</LayoutGeneral>

<style>
    .post-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 3rem 1rem;
        position: relative;
    }

    @media (min-width: 769px) {
        .post-content::before {
            content: '';
            position: absolute;
            top: 0;
            left: 60%;
            width: 600px;
            height: 100%;
            transform: translateX(-50%);
            background-image: url('/heading.png');
            background-size: contain;
            background-position: top center;
            background-repeat: no-repeat;
            opacity: 0.1;
            z-index: -1;
            margin-top: -1rem;
        }
    }

    @media (prefers-color-scheme: dark) { .post-content::before {
        opacity: 0.04;
    }}

    .post-content main {
        flex: 1;
        max-width: 750px;
        margin: auto;
        width: 100%;
        box-sizing: border-box;
    }
</style>
