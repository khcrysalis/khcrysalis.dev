---
import LayoutGeneral from "./LayoutGeneral.astro";
import Head from "@/components/Head.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
---

<LayoutGeneral>
    <Head slot="head" />
    <Header />
    <div class="page-content">
        <main>
            <slot />
            <hr />
            <Footer />
        </main>
    </div>
</LayoutGeneral>

<style>
    .page-content {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    @media (prefers-color-scheme: dark) {
        .page-content::before {
            opacity: 0.04;
        }
    }

    .page-content main {
        flex: 1;
        max-width: 750px;
        margin: auto;
        width: 100%;
        box-sizing: border-box;
    }
</style>
