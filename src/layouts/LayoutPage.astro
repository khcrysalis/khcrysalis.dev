---
import LayoutGeneral from "./LayoutGeneral.astro";
import Head from "@/components/Head.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
---

<LayoutGeneral>
    <Head slot="head"/>
    <Header/>
    <div class="page-content">
        <main>
            <slot/>
            <hr/>
            <Footer/>
        </main>
    </div>
</LayoutGeneral>

<style>
    .page-content {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    @media (min-width: 769px) {
        .page-content::before {
            content: '';
            position: absolute;
            top: 0;
            left: 60%;
            width: 600px;
            height: 100%;
            transform: translateX(-50%);
            background-image: url('/heading.png');
            background-size: contain;
            background-position: top center;
            background-repeat: no-repeat;
            opacity: 0.1;
            z-index: -1;
            margin-top: -1rem;
        }
    }

    @media (prefers-color-scheme: dark) { .page-content::before {
        opacity: 0.04;
    }}

    .page-content main {
        flex: 1;
        max-width: 750px;
        margin: auto;
        width: 100%;
        box-sizing: border-box;
    }
</style>
