---
import Projects from "@/components/ui/Projects.astro";
import LayoutPage from "@/layouts/LayoutPage.astro";
import { STACK_DATA } from "@/utils/constants";
import "@/styles/boxes.scss";
---

<LayoutPage>
    <h1>About</h1>

    <hr/>

    <h2>Who Am I?</h2>

    <div class="box-container" style="border: 1.9px solid var(--button-background-hover)">
        <p>
            My name is samsam, and I'm someone who's passionate about darwin-related software, such as iOS / macOS. I'm mainly known for my projects below.
            <br/><br/>
            Most of my projects are open-source, and I'm always trying to actively contribute to other projects alike. Though, to the closed-source projects I don't release them unless I'm happy with the codebase.
        </p>
    </div>

    <p>I usually make things that should exist, what should exist is merely up to my own interpretation. For example, A is not open source but I want to make an alternative version that is, which is B. I often also contribute to open-source projects on GitHub.</p>
    <p> Find me on
        {STACK_DATA.findme.map(([platform, url], index) => (
            <>
                <a href={url}>{platform}</a>{index < STACK_DATA.findme.length - 1 && ', '}
            </>
        ))}
    </p>

    <hr/>

    <h2>Projects</h2>
    <Projects/>

    <hr/>

    <h2>Tech Stack</h2>
    <p>
        {STACK_DATA.languages.map(([name, url], index) => (
            <>
                <a href={url}>{name}</a>{index < STACK_DATA.languages.length - 1 && ', '}
            </>
        ))}
    </p>

    <hr/>

    <h2>Tooling</h2>
    <p>
        {STACK_DATA.tools.map(([name, url], index) => (
            <>
                <a href={url}>{name}</a>{index < STACK_DATA.tools.length - 1 && ', '}
            </>
        ))}
    </p>
</LayoutPage>
