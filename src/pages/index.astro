---
import LayoutPage from "@/layouts/LayoutPage.astro";
import "@/styles/generic.scss";
import "@/styles/boxes.scss";
import { X_ARRAY } from "@/utils/constants";
import Projects from "@/components/ui/Projects.astro";
---

<LayoutPage>
    <h1>🌱 hii, i'm sammy!</h1>
    <hr />

    <h2>Projects</h2>
    <p>Here are some of the projects I've made or contributed to.</p>
    <Projects />
    <hr />

    <h2>Friends</h2>
    <p>Check out these awesome people, I'm thankful for you being there.</p>
    <div>
        {
            X_ARRAY.map((thing) => (
                <a href={thing.site}>
                    <img
                        src={thing.image}
                        title={thing.site}
                        width="88"
                        height="31"
                        style={{
                            imageRendering: "pixelated",
                        }}
                    />
                </a>
            ))
        }
    </div>
</LayoutPage>
